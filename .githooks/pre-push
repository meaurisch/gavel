#!/bin/sh
# studio convention: no push path bypasses gitleaks (spec D12), and master is
# pull-request-only — anything that changes a repo opens a PR for review.
#
# This hook is the gate that actually binds every actor: `core.hooksPath` is
# wired to .githooks by `studio new`/`adopt`/`conform` AND by every clone the
# worker makes (studio_worker/jobs.py), so agents inherit it too. GitHub-side
# branch protection would be the stronger gate but is unavailable on private
# repos on the Free plan (403 "Upgrade to GitHub Pro").
#
# Scans only the range this push publishes, not full history — a full
# `gitleaks git` scan bricks every push on adopted repos with pre-existing
# secret debt. Uses git's pre-push stdin contract, one line per ref:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
command -v gitleaks >/dev/null 2>&1 || { echo "gitleaks not installed"; exit 1; }

zero="0000000000000000000000000000000000000000"
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # deleting a ref — nothing to scan

    # master/main is pull-request-only. A zero remote_sha means the branch
    # does not exist on the remote yet — that is the initial push that
    # creates it (`studio new`, `studio adopt`), which must still work.
    # Every later push to it is blocked.
    case "$remote_ref" in
        refs/heads/master|refs/heads/main)
            if [ "$remote_sha" != "$zero" ] && [ "$STUDIO_ALLOW_MASTER_PUSH" != "1" ]; then
                echo "studio: $remote_ref is pull-request-only — open a PR instead:"
                echo "    git switch -c <branch> && git push -u origin <branch>"
                echo "    gh pr create"
                echo "  (genuine emergency: STUDIO_ALLOW_MASTER_PUSH=1 git push ...)"
                exit 1
            fi
            ;;
    esac
    if [ "$remote_sha" = "$zero" ]; then
        log_opts="$local_sha --not --remotes"    # new branch: everything not already on a remote
    else
        log_opts="$remote_sha..$local_sha"       # existing branch: just the new commits
    fi
    gitleaks git --no-banner --redact --log-opts "$log_opts" || { echo "gitleaks: push blocked"; exit 1; }
done

# --- README staleness warning (#81) — informational, never blocks ----------
# The #48 ablation showed the README "Current state"/"Next up" convention is
# not kept up from injected memory alone, so the push choke point surfaces it.
# Doctor-style staleness, same thresholds as studio_cli/doctor.py: warn when
# more than 15 commits or 300 changed lines have landed since README.md was
# last touched. Everything here is best-effort — no failure in this block may
# ever break a push, hence the trailing `|| true` and the silenced git calls.
{
    last=$(git log -1 --format=%H -- README.md 2>/dev/null)
    if [ -n "$last" ]; then
        commits=$(git rev-list --count "$last..HEAD" 2>/dev/null)
        commits=${commits:-0}
        lines=$(git diff --shortstat "$last" HEAD -- . ':!README.md' 2>/dev/null |
            awk '{n=0; for (i=2; i<=NF; i++) if ($i ~ /^(insertion|deletion)/) n+=$(i-1); print n}')
        lines=${lines:-0}
        if [ "$commits" -gt 15 ] 2>/dev/null || [ "$lines" -gt 300 ] 2>/dev/null; then
            echo "WARNING: README.md looks stale — $commits commits / $lines changed lines since it was last touched." >&2
            echo "  conventions/session-wrap.md asks the session that changes the project to update" >&2
            echo "  the README's \"Current state\"/\"Next up\" sections. The push proceeds regardless." >&2
        fi
    fi
} || true
