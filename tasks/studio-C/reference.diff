+
+
+# --- build_pr_body: Verified section (conventions/pull-requests.md) ---------
+
+def test_build_pr_body_states_check_command_and_outcome():
+    body = impl.build_pr_body(7, "did the thing", 1,
+                              check_cmd="python tasks.py check", check_passed=True)
+    assert body.startswith("Closes #7")
+    assert "did the thing" in body
+    assert "_studio-worker attempt 1_" in body
+    assert "## Verified" in body
+    assert "python tasks.py check" in body
+    assert "passed" in body
+
+def test_build_pr_body_states_failed_outcome():
+    body = impl.build_pr_body(7, "s", 2, check_cmd="npm test", check_passed=False)
+    assert "## Verified" in body and "npm test" in body and "failed" in body
+
+def test_build_pr_body_not_verified_when_no_check_ran():
+    body = impl.build_pr_body(9, "summary text", 2)
+    assert body.startswith("Closes #9")
+    assert "## Verified" in body
+    assert "Not verified." in body
+
+def test_push_and_pr_body_carries_verification(monkeypatch, tmp_path):
+    """The worker call site's verification info reaches the PR body."""
+    gh = FakeGH()
+    seen = {}
+    monkeypatch.setattr(impl.jobs, "push_branch", lambda dest, branch, token: None)
+    monkeypatch.setattr(impl.gh_ops, "default_branch", lambda gh, repo: "main")
+    def fake_create_pr(gh_obj, repo, head, base, title, body):
+        seen["body"] = body
+        return {"number": 42}
+    monkeypatch.setattr(impl.gh_ops, "create_pr", fake_create_pr)
+    proj = project()
+    proj.owner = None
+    impl.push_and_pr(cfgish(tmp_path), gh, proj, issue(), "agent/issue-7", "summary", 1,
+                     check_cmd="python tasks.py check", check_passed=True)
+    assert "## Verified" in seen["body"]
+    assert "python tasks.py check" in seen["body"]
