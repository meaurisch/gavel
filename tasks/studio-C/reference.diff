+def build_pr_body(issue_number, summary, attempt, check_cmd=None, check_passed=None):
+    """Assemble a worker PR body.
+
+    Always closes the issue, carries the adapter's summary and the attempt
+    marker, and ends with a ``## Verified`` section: the exact check command
+    that was run and its outcome, or the line "Not verified." when nothing was
+    run (conventions/pull-requests.md — a PR body states what was actually run
+    to verify it, or says it wasn't)."""
+    body = f"Closes #{issue_number}\n\n{summary}\n\n_studio-worker attempt {attempt}_"
+    if check_cmd:
+        outcome = "passed" if check_passed else "failed"
+        verified = f"Ran `{check_cmd}` — {outcome}."
+    else:
+        verified = "Not verified."
+    return f"{body}\n\n## Verified\n\n{verified}"
+
