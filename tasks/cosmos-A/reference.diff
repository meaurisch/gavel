@@ -0,0 +1,42 @@
+using CleanArchitectureCosmosDB.Core.Entities;
+using CleanArchitectureCosmosDB.WebAPI.Models.ToDoItem;
+using Newtonsoft.Json;
+
+namespace CleanArchitectureCosmosDB.WebAPI.Mappers
+{
+    public static class ToDoItemApiMapper
+    {
+        public static ToDoItemModel ToModel(Core.Entities.ToDoItem entity)
+        {
+            var model = new ToDoItemModel
+            {
+                Id = entity.Id,
+                Category = entity.Category,
+                Title = entity.Title
+            };
+
+            // IsCompleted has a private set on ToDoItemModel
+            typeof(ToDoItemModel).GetProperty("IsCompleted").SetValue(model, entity.IsCompleted);
+
+            return model;
+        }
+
+        public static Core.Entities.ToDoItem ToEntity(Create.CreateToDoItemCommand command)
+        {
+            return new Core.Entities.ToDoItem
+            {
+                Category = command.Category,
+                Title = command.Title
+            };
+        }
+
+        public static ToDoItemAuditModel ToAuditModel(Audit audit)
+        {
+            return new ToDoItemAuditModel
+            {
+                ToDoItemModel = JsonConvert.DeserializeObject<ToDoItemModel>(audit.Entity),
+                DateCreatedUTC = audit.DateCreatedUTC
+            };
+        }
+    }
+}
