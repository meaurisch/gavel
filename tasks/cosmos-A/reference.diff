index 0000000..54099bf
--- /dev/null
+++ b/src/CleanArchitectureCosmosDB.Infrastructure/CosmosDbData/Mappers/ToDoItemMapper.cs
@@ -0,0 +1,35 @@
+using CleanArchitectureCosmosDB.Core.Entities;
+using CleanArchitectureCosmosDB.Infrastructure.CosmosDbData.Models;
+
+namespace CleanArchitectureCosmosDB.Infrastructure.CosmosDbData.Mappers
+{
+    public static class ToDoItemMapper
+    {
+        public static ToDoItemDocument ToDocument(ToDoItem entity)
+        {
+            return new ToDoItemDocument
+            {
+                Id = entity.Id,
+                Category = entity.Category,
+                Title = entity.Title,
+                IsCompleted = entity.IsCompleted,
+                Type = "todoitem"
+            };
+        }
+
+        public static ToDoItem ToDomain(ToDoItemDocument document)
+        {
+            var entity = new ToDoItem
+            {
+                Id = document.Id,
+                Category = document.Category,
+                Title = document.Title
+            };
+
+            // IsCompleted has a private set on the domain entity
+            typeof(ToDoItem).GetProperty("IsCompleted").SetValue(entity, document.IsCompleted);
+
+            return entity;
+        }
+    }
+}
