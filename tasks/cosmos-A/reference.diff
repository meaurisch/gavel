index 0000000..3bfc898
--- /dev/null
+++ b/src/CleanArchitectureCosmosDB.Infrastructure/CosmosDbData/Mappers/AuditMapper.cs
@@ -0,0 +1,30 @@
+using CleanArchitectureCosmosDB.Core.Entities;
+using CleanArchitectureCosmosDB.Infrastructure.CosmosDbData.Models;
+
+namespace CleanArchitectureCosmosDB.Infrastructure.CosmosDbData.Mappers
+{
+    public static class AuditMapper
+    {
+        public static AuditDocument ToDocument(Audit entity)
+        {
+            return new AuditDocument
+            {
+                Id = entity.Id,
+                EntityType = entity.EntityType,
+                EntityId = entity.EntityId,
+                Entity = entity.Entity,
+                DateCreatedUtc = entity.DateCreatedUTC,
+                Type = "audit"
+            };
+        }
+
+        public static Audit ToDomain(AuditDocument document)
+        {
+            var audit = new Audit(document.EntityType, document.EntityId, document.Entity);
+            audit.Id = document.Id;
+            // Overwrite the constructor-set DateTime.UtcNow with the stored value
+            audit.DateCreatedUTC = document.DateCreatedUtc;
+            return audit;
+        }
+    }
+}
diff --git a/src/CleanArchitectureCosmosDB.Infrastructure/CosmosDbData/Mappers/ToDoItemMapper.cs b/src/CleanArchitectureCosmosDB.Infrastructure/CosmosDbData/Mappers/ToDoItemMapper.cs
