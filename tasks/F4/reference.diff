+
 class PersonalizationConfig(BaseModel):
     """Configuration for personalization settings."""
     serendipity: float = Field(ge=0.0, le=1.0)
@@ -116,6 +121,20 @@ class PersonalizationConfig(BaseModel):
     exploration_rate: float = Field(ge=0.0, le=1.0)
     topic_weights: Dict[str, float]
 
+    @model_validator(mode="after")
+    def _topic_weights_sum_to_one(self) -> "PersonalizationConfig":
+        """An empty mapping means "no topic preferences" and is allowed; any
+        non-empty one must be a distribution."""
+        if not self.topic_weights:
+            return self
+        total = sum(self.topic_weights.values())
+        if abs(total - 1.0) > TOPIC_WEIGHT_TOLERANCE:
+            raise ValueError(
+                f"personalization.topic_weights must sum to 1.0, got {total} "
+                f"from {dict(self.topic_weights)}"
+            )
+        return self
+
 
