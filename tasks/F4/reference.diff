     news: NewsConfig
 
 
+# topic_weights is a distribution, so it has to add up. Floats being floats,
+# 0.4 + 0.3 + 0.2 + 0.1 is not exactly 1.0 — compare with a tolerance.
+TOPIC_WEIGHT_TOLERANCE = 1e-6
