diff --git a/tests/test_model_catalogue.py b/tests/test_model_catalogue.py
new file mode 100644
index 0000000..e6a47bf
--- /dev/null
+++ b/tests/test_model_catalogue.py
@@ -0,0 +1,45 @@
+"""Every model id in config.yaml must exist in the provider's catalogue.
+
+A withdrawn id only shows up at generation time, as a 404 and an empty paper.
+This turns it into a red build instead. `tests/fixtures/openrouter-models.json`
+is a pinned snapshot of the OpenRouter catalogue.
+"""
+import json
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+CONFIG = ROOT / "config.yaml"
+CATALOGUE = ROOT / "tests" / "fixtures" / "openrouter-models.json"
+
+
+def configured_model_ids() -> dict:
+    """{config key: model id} for every model configured under `llm:`."""
+    llm = (yaml.safe_load(CONFIG.read_text(encoding="utf-8")) or {}).get("llm") or {}
+    ids = {}
+    if llm.get("model"):
+        ids["model"] = llm["model"]
+    for stage, model_id in (llm.get("models") or {}).items():
+        ids[f"models.{stage}"] = model_id
+    return ids
+
+
+def catalogue_ids() -> set:
+    return {entry["id"] for entry in json.loads(CATALOGUE.read_text(encoding="utf-8"))["data"]}
+
+
+def test_catalogue_snapshot_is_readable():
+    assert catalogue_ids(), f"{CATALOGUE.name} lists no models"
+
+
+def test_configured_models_are_in_the_catalogue():
+    configured = configured_model_ids()
+    assert configured, "config.yaml configures no model under `llm:`"
+    catalogue = catalogue_ids()
+    missing = {key: model_id for key, model_id in configured.items()
+               if model_id not in catalogue}
+    assert not missing, (
+        f"withdrawn model id(s) in config.yaml, not present in {CATALOGUE.name}: "
+        f"{missing}"
+    )
