+    MAX_DETAIL_EXPORT = 200
+
+    @classmethod
+    def _flatten_detail(cls, detail):
+        """One line, at most MAX_DETAIL_EXPORT chars, for the CSV export.
+
+        Multi-line details (pytest tails, tracebacks) are joined on single
+        spaces; anything over the cap is truncated with an ellipsis. A short
+        single-line detail passes through unchanged, and None/'' stay as-is so
+        the CSV cell semantics don't shift."""
+        if not detail:
+            return detail
+        flat = " ".join(part.strip() for part in str(detail).splitlines() if part.strip())
+        if len(flat) > cls.MAX_DETAIL_EXPORT:
+            flat = flat[:cls.MAX_DETAIL_EXPORT - 1] + "…"
+        return flat
+
     def export_csv(self, dest_path):
