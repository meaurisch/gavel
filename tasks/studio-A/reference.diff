+
+# --- export_csv detail flattening -------------------------------------------
+
+def _exported_detail_cells(path):
+    import csv
+    with open(path, newline="", encoding="utf-8") as f:
+        rows = list(csv.reader(f))
+    return [r[-1] for r in rows[1:]]
+
+def test_export_csv_flattens_multiline_overlong_detail(tmp_path):
+    lg = Ledger(tmp_path / "s.db")
+    tail = "\n".join(f"FAILED tests/test_x.py::test_{i} - AssertionError" for i in range(40))
+    lg.record("implement_attempt", outcome="check-failed", detail=tail)
+    n = lg.export_csv(tmp_path / "ledger.csv")
+    cells = _exported_detail_cells(tmp_path / "ledger.csv")
+    assert n == 1 and len(cells) == 1          # row count preserved
+    cell = cells[0]
+    assert "\n" not in cell and "\r" not in cell
+    assert len(cell) <= 200
+    assert cell.endswith("…")
+
+def test_export_csv_leaves_short_detail_unchanged(tmp_path):
+    lg = Ledger(tmp_path / "s.db")
+    lg.record("cycle", outcome="ok", detail="comment=1234 handled")
+    lg.export_csv(tmp_path / "ledger.csv")
+    assert _exported_detail_cells(tmp_path / "ledger.csv") == ["comment=1234 handled"]
+
+def test_export_csv_row_count_preserved_across_mixed_details(tmp_path):
+    lg = Ledger(tmp_path / "s.db")
+    lg.record("a", detail="short")
+    lg.record("b", detail="x" * 500)
+    lg.record("c")                              # detail defaults to ""
+    n = lg.export_csv(tmp_path / "ledger.csv")
+    cells = _exported_detail_cells(tmp_path / "ledger.csv")
+    assert n == 3 and len(cells) == 3
+    assert cells[0] == "short"
+    assert len(cells[1]) <= 200 and cells[1].endswith("…")
