diff --git a/tests/test_cli_conform.py b/tests/test_cli_conform.py
index 488c9a3..b169443 100644
--- a/tests/test_cli_conform.py
+++ b/tests/test_cli_conform.py
@@ -180,3 +180,70 @@ def test_conform_protects_master_and_survives_a_free_plan_repo(tmp_path, monkeyp
     assert res.exit_code == 0, res.output
     assert "master protection unavailable" in res.output
     assert "pre-push gate" in res.output
+
+
+# --- behaviour 4: description vs README "What & why" (naming.md rule 6) -----
+
+@pytest.fixture
+def registry_with_local_readme(monkeypatch, tmp_path):
+    """A registered project whose local path holds only a README (no .git, so
+    conform skips the template-file block and touches no git state)."""
+    proj = tmp_path / "gavel"
+    proj.mkdir()
+    registry_path = tmp_path / "studio.yaml"
+    registry_path.write_text(
+        "projects:\n"
+        "  gavel:\n"
+        "    repo: meaurisch/gavel\n"
+        "    tier: monthly\n"
+        "    check: python3 tasks.py check\n"
+        "    path: gavel\n"
+    )
+    monkeypatch.setattr(cli_mod, "REGISTRY_PATH", registry_path)
+    monkeypatch.setattr(cli_mod, "STUDIO_ROOT", tmp_path)
+    return proj
+
+def _write_readme(proj, sentence):
+    (proj / "README.md").write_text(
+        f"# gavel\n\n## What & why\n{sentence} More detail follows\nhere.\n\n## Quickstart\nx\n",
+        encoding="utf-8")
+
+def test_conform_warns_when_description_disagrees_with_readme(runner, fake_gh,
+                                                              registry_with_local_readme):
+    _write_readme(registry_with_local_readme,
+                  "This repo benchmarks agentic coding setups blind.")
+    fake_gh.repos["/repos/meaurisch/gavel"] = {"description": "This repo grades cheese."}
+    res = runner.invoke(main, ["conform", "gavel"])
+    assert res.exit_code == 0, res.output
+    assert "WARNING" in res.output and "naming.md rule 6" in res.output
+    # the warning names both sides of the disagreement
+    assert "This repo grades cheese." in res.output
+    assert "This repo benchmarks agentic coding setups blind." in res.output
+
+def test_conform_accepts_description_agreeing_modulo_normalisation(runner, fake_gh,
+                                                                   registry_with_local_readme):
+    _write_readme(registry_with_local_readme,
+                  "This repo benchmarks   agentic coding setups blind.")
+    # differs in case, internal whitespace, and trailing period only
+    fake_gh.repos["/repos/meaurisch/gavel"] = {
+        "description": "this repo Benchmarks agentic coding setups blind"}
+    res = runner.invoke(main, ["conform", "gavel"])
+    assert res.exit_code == 0, res.output
+    assert "disagrees" not in res.output
+
+def test_conform_no_agreement_warning_without_what_why_section(runner, fake_gh,
+                                                               registry_with_local_readme):
+    (registry_with_local_readme / "README.md").write_text("# gavel\n\nno sections\n",
+                                                          encoding="utf-8")
+    fake_gh.repos["/repos/meaurisch/gavel"] = {"description": "This repo does things."}
+    res = runner.invoke(main, ["conform", "gavel"])
+    assert res.exit_code == 0, res.output
+    assert "disagrees" not in res.output
+
+def test_conform_missing_description_still_warns_not_errors(runner, fake_gh,
+                                                            registry_with_local_readme):
+    _write_readme(registry_with_local_readme, "This repo benchmarks things.")
+    fake_gh.repos["/repos/meaurisch/gavel"] = {"description": None}
+    res = runner.invoke(main, ["conform", "gavel"])
+    assert res.exit_code == 0 and "MISSING" in res.output
+    assert "disagrees" not in res.output
