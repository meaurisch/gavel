+# naming.md rule 6: the GitHub description completes "This repo ..." and the
+# README's "What & why" opens with the same sentence — they must never disagree.
+_WHAT_WHY_RE = re.compile(r"^##\s*What\s*&\s*why[ \t]*\r?\n(.*?)(?=^##\s|\Z)",
+                          re.MULTILINE | re.DOTALL)
+
+def _readme_what_why_sentence(readme_path):
+    """First sentence of the README's "## What & why" section, or None when
+    the README or the section is absent/empty."""
+    try:
+        text = Path(readme_path).read_text(encoding="utf-8")
+    except OSError:
+        return None
+    m = _WHAT_WHY_RE.search(text)
+    if not m:
+        return None
+    body = " ".join(m.group(1).split())
+    if not body:
+        return None
+    sentence = re.match(r"(.+?[.!?])(?=\s|$)", body)
+    return sentence.group(1) if sentence else body
+
+def _normalised_sentence(s):
+    """Comparison form of a description/README sentence: collapsed whitespace,
+    casefolded, trailing period dropped."""
+    return " ".join(s.split()).casefold().rstrip(".")
+
